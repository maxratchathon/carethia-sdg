{
  "name": "@carethia/db",
  "version": "1.0.0",
  "private": true,
  "description": "Database schema and migrations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "generate": "drizzle-kit generate:pg --config=drizzle.config.ts",
    "migrate": "node --loader ts-node/esm ./src/migrate.ts",
    "seed": "node --loader ts-node/esm ./src/seed.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.29.0",
    "pg": "^8.11.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.20.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
